# Frontend API base URL (Vite exposes only VITE_* vars to the client)
# Local dev — use your running FastAPI backend:
# VITE_API_URL=http://127.0.0.1:5000

# Production (Railway) — deploy the new backend with /api/v1/me before using:
# VITE_API_URL=https://elera-backend-production-aa3a.up.railway.app
